# คัดลอกเป็น /home/syaco/backend/hrms-api/hrms-api.env บน 112 แล้วแก้ค่า (chmod 600) -- ห้าม commit ไฟล์จริง
# ค่าด้านล่างเป็นตัวอย่าง ต้องสร้างค่าใหม่ ไม่ใช้ค่าที่เคยอยู่ใน appsettings.json (ถือว่ารั่วแล้ว)
ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__DefaultConnection=Host=/var/run/postgresql;Port=5432;Database=hrmsdb;Username=hrms_app;Password=CHANGE_ME;SearchPath=hrms;SSL Mode=Disable;Maximum Pool Size=10;Minimum Pool Size=2;Connection Idle Lifetime=60;Keepalive=30;Timeout=30;Command Timeout=30;
Jwt__SecretKey=CHANGE_ME_random_64+_chars
Jwt__ExpiryMinutes=480
# สำคัญ: Encryption__SecretKey ต้องเป็นค่าเดิมที่ใช้เข้ารหัสข้อมูลใน DB อยู่ ถ้าเปลี่ยนจะถอดรหัสข้อมูลเดิมไม่ได้ (ต้อง migrate ก่อน)
Encryption__SecretKey=CHANGE_ME
Smtp__Host=smtp.gmail.com
Smtp__Port=587
Smtp__SenderEmail=CHANGE_ME
Smtp__AppPassword=CHANGE_ME
Smtp__FrontendUrl=https://hrms.syaco.co.th
Cors__AllowedOrigins__0=https://hrms.syaco.co.th
# ค่าไม่ลับ (image ไม่มีค่าเหล่านี้แล้ว ต้องกำหนดใน env)
Jwt__Issuer=HrmsApi
Jwt__Audience=HrmsClient
Smtp__SenderName=ระบบ HRMS
Smtp__EnableSsl=true
